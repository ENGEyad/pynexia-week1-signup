        android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/logo" android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/ic_logo" android:contentDescription="@string/logo_description"/><TextView style="@style/Eyebrow" android:text="@string/success_label" /><TextView style="@style/Title" android:text="@string/success_title" /><TextView style="@style/Body" android:text="@string/success_body" /><TextView android:id="@+id/profile" style="@style/Body" android:background="@drawable/card" android:padding="24dp"/><Button android:id="@+id/another" style="@style/PrimaryButton" android:text="@string/another" />
    </LinearLayout>
</ScrollView>
